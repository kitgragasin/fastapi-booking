#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
else
  PYTHON_BIN="python3"
fi

if [[ "${1:-}" == "--reset" ]]; then
  export FASTAPI_BOOKING_RESET_DB=1
fi

PYTHONPATH="$ROOT_DIR" "$PYTHON_BIN" -m app
